# ==============================================================================
# Mu-CI Distributed Execution Worker Environment Configuration
# Path: /etc/mu-ci-worker/worker.env (Permissions: 0600 mu-ci-worker:mu-ci-worker)
# ==============================================================================

# Unique identifier for this worker node (e.g. node-a, node-b, worker-riscv64, worker-aarch64)
MU_CI_WORKER_NODE_ID=worker-node

# WebSocket URL to Controller cluster tunnel
# Local controller:  ws://127.0.0.1:8000/api/cluster/tunnel
# Remote controller: ws://192.0.2.10:8000/api/cluster/tunnel
# Over WAN:          wss://hook.example.com/api/cluster/tunnel
MU_CI_WORKER_CONTROLLER_URL=ws://192.0.2.10:8000/api/cluster/tunnel

# Path to shared authentication token file (or literal token)
MU_CI_WORKER_CLUSTER_TOKEN=/etc/mu-ci-worker/cluster_token

# Concurrency execution slots on this worker node (1 recommended; scale threads via CARGO_BUILD_JOBS / MU_CI_WORKER_THREADS)
MU_CI_WORKER_MAX_SLOTS=1
# Legacy alias also accepted: MU_CI_WORKER_SLOTS=1

# Optional compiler/worker build thread override for cargo tasks
CARGO_BUILD_JOBS=6
# MU_CI_WORKER_THREADS=6

# Comma-separated capability tags advertised to the DAG stage scheduler
# x86_64 light:   x86_64,linux,n100,fmt,audit,docs
# x86_64 heavy:   x86_64,linux,xeon,clippy,cross-compile,riscv64,build,test
# SpacemiT K3:    riscv64,spacemit,k3,x100,a100,native,ground-truth,bench,verification
MU_CI_WORKER_TAGS=x86_64,linux,worker

# Base workspace directory for git caches and stage builds
MU_CI_WORKER_WORKSPACE=/var/lib/mu-ci-worker/workspace

# Enable Btrfs subvolume snapshot isolation (true if workspace is on a Btrfs filesystem)
MU_CI_WORKER_USE_BTRFS=true

# Optional sandbox and cache overrides
# MU_CI_WORKER_ISOLATION=none
# MU_CI_WORKER_SCCACHE_ENV_FILE=/etc/mu-ci-worker/sccache.env
# MU_CI_ISOLATION_CEILING_PATH=/etc/mu-ci-isolation/ceiling.yml

# Optional Toolchain Roots (for cross-compiler or native edge compiler discovery)
# LLVM_TOOLCHAIN_ROOT=/opt/cross-llvm-24
# GCC_TOOLCHAIN_ROOT=/opt/cross-gcc-17

# Logging level
RUST_LOG=info,mu_ci_worker=debug
